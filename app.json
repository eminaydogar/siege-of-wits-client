{
  "expo": {
    "name": "Fetih Bilgi Yarışması",
    "slug": "fetih-bilgi-yarismasi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#051F61"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "backgroundColor": "#051F61"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-status-bar",
      "expo-font",
      "expo-asset",
      "expo-system-ui",
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafını seçebilmek için galerine erişim izni gerekiyor."
        }
      ]
    ],
    "backgroundColor": "#051F61"
  }
}
